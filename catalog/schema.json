{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/josh-wong/taorc/catalog/schema.json",
  "title": "taorc rule catalog",
  "description": "Schema for catalog/rules.yaml, the registry of every taorc rule ID.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "category",
        "title",
        "instruction",
        "chapter",
        "severity",
        "lintable"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[PNACFEVSTX][0-9]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "principles",
            "names",
            "aesthetics",
            "comments",
            "control-flow",
            "expressions",
            "variables",
            "structure",
            "tests",
            "guardrails"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "chapter": {
          "type": "integer",
          "minimum": 0
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "suggestion"]
        },
        "lintable": {
          "type": "boolean"
        },
        "lint_rule": {
          "type": "string",
          "pattern": "^taorc-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "all",
              "python",
              "typescript",
              "go",
              "rust",
              "java",
              "csharp"
            ]
          },
          "default": ["all"],
          "minItems": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lang", "before", "after"],
            "additionalProperties": false,
            "properties": {
              "lang": { "type": "string" },
              "before": { "type": "string" },
              "after": { "type": "string" }
            }
          }
        },
        "exceptions": {
          "type": "string"
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^[PNACFEVSTX][0-9]+$"
        }
      },
      "if": {
        "properties": { "lintable": { "const": true } },
        "required": ["lintable"]
      },
      "then": {
        "required": ["lint_rule"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "deprecated": { "const": true } },
            "required": ["deprecated"]
          },
          "then": {
            "required": ["superseded_by"]
          }
        }
      ]
    }
  }
}
